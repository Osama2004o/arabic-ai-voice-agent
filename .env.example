# ---------------------------------------------------------------
# Copy to .env and fill in. Never commit .env or real keys.
# ---------------------------------------------------------------

# --- App / security ---
APP_ENV=development             # development | production
# Required header X-API-Key for POST /send-email and /send-telegram.
# In production these endpoints refuse all requests until this is set.
API_KEY=change_me_to_a_long_random_string
CORS_ORIGINS=*                  # comma-separated, e.g. https://your-app.onrender.com
NOTIFY_RATE_LIMIT_PER_MIN=5

# --- LLM / speech ---
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
STT_PROVIDER=groq               # groq | local
GROQ_STT_MODEL=whisper-large-v3-turbo
LOCAL_WHISPER_MODEL=small
TTS_PROVIDER=elevenlabs          # edge | elevenlabs
DEFAULT_VOICE=female            # male | female | male_msa | female_msa
# ElevenLabs Configuration (Free Tier supported: eleven_multilingual_v2, eleven_flash_v2_5)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_VOICE_FEMALE=EXAVITQu4vr4xnSDxMaL   # Sarah (Free-tier pre-made)
ELEVENLABS_VOICE_MALE=pNInz6obpgDQGcFmaJgB     # Adam (Free-tier pre-made)
LLM_MODEL=openrouter/free
LLM_STUB_MODEL=openrouter/free
AGENT_LLM_PROVIDER=groq         # groq | openrouter
AGENT_LLM_MODEL=qwen/qwen3.8-27b
AGENT_FALLBACK_MODEL=openrouter/free
AGENT_DEFAULT_DIALECT=egyptian  # egyptian | msa

# --- Email ---
# smtp   = any SMTP server (Gmail: smtp.gmail.com, port 587, use an App Password)
# resend = Resend HTTPS API (use this if your host blocks SMTP ports, e.g. many free tiers)
EMAIL_PROVIDER=smtp
EMAIL_FROM=your_address@gmail.com
EMAIL_FROM_NAME=خدمة العملاء
EMAIL_ALLOWED_DOMAINS=          # optional, e.g. gmail.com,outlook.com (empty = any domain)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587                   # 587 = STARTTLS, 465 = SSL
SMTP_USERNAME=your_address@gmail.com
SMTP_PASSWORD=your_16_char_app_password
RESEND_API_KEY=

# --- Telegram ---
# 1) Create a bot with @BotFather -> token
# 2) Send your bot a message, then open https://api.telegram.org/bot<TOKEN>/getUpdates -> chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
